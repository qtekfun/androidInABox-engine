<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">



    <PreferenceCategory app:title="@string/background_category">

        <Preference
                android:key="battery_exemption"
                android:title="@string/battery_exemption" />

        <Preference
                android:key="rom_autostart"
                android:title="@string/rom_autostart"
                android:summary="@string/rom_autostart_summary" />

        <SwitchPreferenceCompat
                app:key="start_on_boot"
                app:title="@string/start_on_boot"
                app:summary="@string/start_on_boot_summary" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/other">

        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"/>



        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="@string/hide_root" />

        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="@string/daemon_enable" />

        <SwitchPreferenceCompat
                app:key="use_vpn_network"
                app:title="@string/use_vpn_network"
                app:summary="@string/use_vpn_network_summary" />

        <SwitchPreferenceCompat
                app:key="disable_flag_secure"
                app:title="@string/disable_flag_secure"
                app:summary="@string/disable_flag_secure_summary" />

        <SwitchPreferenceCompat
                app:key="notification_title_prefix"
                app:title="@string/notification_title_prefix"
                app:summary="@string/notification_title_prefix_summary" />


    </PreferenceCategory>

</PreferenceScreen>